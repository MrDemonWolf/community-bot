# Bootstrap only. Set platform credentials later in the dashboard.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgresql://community_bot:replace-with-a-long-url-safe-password@localhost:5435/community_bot
APP_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
OWNER_EMAIL=you@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEV_LOGIN=false
NODE_ENV=development
