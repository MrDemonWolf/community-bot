# ============================================================================
# community-bot .env.example
# Copy to apps/server/.env (and apps/web/.env where noted) and fill in.
# Each var lists the phase that first uses it.
# Never commit a populated .env file.
# ============================================================================

# ---- Core (Phase -1) -------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug                      # trace|debug|info|warn|error|fatal
SERVICE_NAME=community-bot
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_URL_TEST=                   # optional: separate DB used by integration tests

# ---- Better-Auth (Phase -1) ------------------------------------------------
BETTER_AUTH_SECRET=                  # >=32 chars, random
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# ---- Encryption (Phase -1) -------------------------------------------------
# JSON: { "v1": "<base64 of 32-byte key>", "v2": "..." }. Rotate by adding v2 and bumping VERSION.
ENCRYPTION_KEYS=
ENCRYPTION_KEY_VERSION=v1

# ---- Twitch OAuth (Phase -1 / Phase 0 wizard) ------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Broadcaster-side and bot-side tokens are populated by the setup wizard (Phase 0).

# ---- Discord OAuth + bot (Phase 0/1) ---------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# ---- Brain Cells / loyalty (Phase 4) ---------------------------------------
BRAIN_CELLS_DEFAULT_EARN_PER_MIN=1

# ---- Flows sandbox (Phase 5B) ----------------------------------------------
FLOW_SANDBOX_MEMORY_MB=64
FLOW_SANDBOX_TIMEOUT_MS=2000
FLOW_FETCH_ALLOWLIST=                # comma-separated hostnames

# ---- AI (Phase 8) ----------------------------------------------------------
GOOGLE_GENAI_API_KEY=
AI_MONTHLY_COST_CAP_USD=25

# ---- Observability (Phase 1, 9) --------------------------------------------
SENTRY_DSN=
SENTRY_ENV=development

# ---- Deployment (Phase 9) --------------------------------------------------
DOKPLOY_HOST=
DOKPLOY_TOKEN=

# ---- Web app (apps/web/.env) -----------------------------------------------
# VITE_PUBLIC_TRPC_URL=http://localhost:3000/trpc
# VITE_PUBLIC_AUTH_URL=http://localhost:3000/api/auth
