NODE_ENV=development

# Better-Auth — secret >=32 chars. openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same-origin in dev (Next on 3001). Prod: dashboard URL.
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Local Supabase (supabase start, in packages/db). Prod: hosted Supabase URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Encrypts secrets (Twitch tokens etc.) at rest. openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Twitch app (dev.twitch.tv/console/apps). Redirect: <BETTER_AUTH_URL>/api/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional / coming soon (Part 2)
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# GEMINI_API_KEY=
