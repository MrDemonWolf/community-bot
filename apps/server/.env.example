# ── Required (MVP) ───────────────────────────────────────────────
NODE_ENV=development

# Local dev = supabase/postgres container (run: bun run db:up).
# Prod = Supabase connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Better-Auth — secret must be >=32 chars. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Web origin (dev: vite 5173, prod: dashboard URL)
CORS_ORIGIN=http://localhost:5173

# Encrypts secrets (Twitch tokens etc.) at rest. openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── Twitch (M0.2 setup wizard / M0.3 chat worker) ────────────────
# One Twitch app serves both broadcaster + wolfaid bot logins.
# dev.twitch.tv/console/apps — Redirect: http://localhost:3000/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Optional / coming soon (Part 2) ──────────────────────────────
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# GEMINI_API_KEY=
# WEATHERKIT_KEY_ID=
# WEATHERKIT_TEAM_ID=
# WEATHERKIT_P8=
