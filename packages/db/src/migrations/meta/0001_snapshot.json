      "checkConstraints": {
        "settings_singleton": {
          "name": "settings_singleton",
          "value": "\"settings\".\"id\" = 'singleton'"
        },
        "settings_bot_name": {
          "name": "settings_bot_name",
          "value": "char_length(btrim(\"settings\".\"bot_name\")) BETWEEN 1 AND 40"
        },
        "settings_command_prefix": {
          "name": "settings_command_prefix",
          "value": "char_length(\"settings\".\"command_prefix\") BETWEEN 1 AND 5 AND \"settings\".\"command_prefix\" !~ '[[:space:]]'"
        },
        "settings_public_description": {
          "name": "settings_public_description",
          "value": "char_length(\"settings\".\"public_description\") <= 280"
        },
        "settings_discord_status": {
          "name": "settings_discord_status",
          "value": "\"settings\".\"discord_status\" IN ('online', 'idle', 'dnd', 'invisible')"
        },
        "settings_discord_activity_type": {
          "name": "settings_discord_activity_type",
          "value": "\"settings\".\"discord_activity_type\" IN ('playing', 'listening', 'watching', 'competing', 'custom', 'streaming')"
        },
        "settings_discord_activity_text": {
          "name": "settings_discord_activity_text",
          "value": "char_length(\"settings\".\"discord_activity_text\") <= 128"
        },
        "settings_discord_activity_url": {
          "name": "settings_discord_activity_url",
          "value": "\"settings\".\"discord_activity_url\" IS NULL OR char_length(\"settings\".\"discord_activity_url\") <= 500"
        },
        "settings_discord_application_id": {
          "name": "settings_discord_application_id",
          "value": "\"settings\".\"discord_application_id\" IS NULL OR \"settings\".\"discord_application_id\" ~ '^[0-9]{17,20}$'"
        },
        "settings_discord_guild_id": {
          "name": "settings_discord_guild_id",
          "value": "\"settings\".\"discord_guild_id\" IS NULL OR \"settings\".\"discord_guild_id\" ~ '^[0-9]{17,20}$'"
        },
        "settings_twitch_client_id": {
          "name": "settings_twitch_client_id",
          "value": "\"settings\".\"twitch_client_id\" IS NULL OR \"settings\".\"twitch_client_id\" ~ '^[a-zA-Z0-9]{10,100}$'"
        },
        "settings_broadcaster_identity": {
          "name": "settings_broadcaster_identity",
          "value": "num_nonnulls(\"settings\".\"broadcaster_user_id\", \"settings\".\"broadcaster_login\", \"settings\".\"broadcaster_token_enc\") IN (0, 3)"
        },
        "settings_bot_identity": {
          "name": "settings_bot_identity",
          "value": "num_nonnulls(\"settings\".\"bot_user_id\", \"settings\".\"bot_login\", \"settings\".\"bot_token_enc\") IN (0, 3)"
        },
        "settings_discord_enabled_credentials": {
          "name": "settings_discord_enabled_credentials",
          "value": "NOT \"settings\".\"discord_enabled\" OR num_nonnulls(\"settings\".\"discord_token_enc\", \"settings\".\"discord_application_id\", \"settings\".\"discord_guild_id\") = 3"
        },
        "settings_twitch_enabled_credentials": {
          "name": "settings_twitch_enabled_credentials",
          "value": "NOT \"settings\".\"twitch_enabled\" OR num_nonnulls(\"settings\".\"twitch_client_id\", \"settings\".\"twitch_client_secret_enc\", \"settings\".\"broadcaster_token_enc\", \"settings\".\"bot_token_enc\") = 4"
        }
      },
      "isRLSEnabled": false
    }
