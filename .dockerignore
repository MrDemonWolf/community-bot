.git
# Only revision metadata enters builds; repository config, credentials, and history remain excluded.
!.git/
.git/*
!.git/HEAD
!.git/packed-refs
!.git/refs/
.git/refs/*
!.git/refs/heads/
!.git/refs/heads/**
**/node_modules
**/.next
**/dist
**/out
**/.turbo
**/*.tsbuildinfo
**/.env
**/.env.*
!.env.example
**/*.log
**/test-results
**/playwright-report
.DS_Store
