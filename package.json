{
  "name": "community-bot",
  "description": "A single-creator Discord and Twitch bot with a Next.js dashboard, Channel Points, and platform-scoped staff roles.",
  "license": "MIT",
  "author": "MrDemonWolf, Inc.",
  "repository": { "type": "git", "url": "git+https://github.com/MrDemonWolf/community-bot.git" },
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "lucide-react": "^0.546.0",
      "next": "^16.2.0",
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "sonner": "^2.0.5",
      "@trpc/server": "^11.16.0",
      "@trpc/client": "^11.16.0",
      "better-auth": "1.6.11",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env run turbo dev",
    "build": "NODE_ENV=production turbo build",
    "check-types": "turbo check-types",
    "test": "bun test apps/discord/src apps/twitch/src packages/core/src packages/auth/src packages/api/src packages/db/src tests/oauth-state.test.ts tests/navigation.test.ts tests/crop-geometry.test.ts",
    "dev:docs": "bun run --cwd apps/docs dev",
    "dev:web": "bun --env-file=.env run turbo -F web dev",
    "dev:twitch": "bun --env-file=.env run turbo -F twitch dev",
    "dev:discord": "bun --env-file=.env run turbo -F discord dev",
    "db:push": "turbo -F @community-bot/db db:push",
    "db:studio": "turbo -F @community-bot/db db:studio",
    "db:generate": "turbo -F @community-bot/db db:generate",
    "db:migrate": "turbo -F @community-bot/db db:migrate"
  },
  "dependencies": {
    "@community-bot/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@community-bot/config": "workspace:*",
    "@types/node": "^22.13.14",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.3"
}
